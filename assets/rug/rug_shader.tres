code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D rug : filter_nearest;
uniform sampler2D bloody_rug : filter_nearest;
uniform bool Blood = false;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(rug, UV);


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(bloody_rug, UV);


// BooleanParameter:7
	bool n_out7p0 = Blood;


// Mix:4
	vec3 n_out4p0 = mix(vec3(n_out3p0.xyz), vec3(n_out2p0.xyz), (n_out7p0 ? 1.0 : 0.0));


// Output:0
	ALBEDO = n_out4p0;


}
