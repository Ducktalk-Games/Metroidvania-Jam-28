script/source = "@icon(\"res://lib/icons/checkpoint-icon.svg\")
class_name CheckPoint
extends Area3D

@export
var is_used: bool = false
signal set_respawn_point(point: Vector3)

func _ready() -> void:
	pass 

func _process(delta: float) -> void:
	pass


func _on_body_entered(body: Node3D) -> void:
	print(\"checkpoint Reached:\" + body.name)
	# Try cast into character
	if(body == %StageBody):
		print(\"checkpoint Reached:\" + self.id)
		is_used = true
		set_respawn_point.emit(self.global_position)
		pass
"

